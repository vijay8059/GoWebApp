# Copy to .env and edit. Do NOT commit .env.

# --- runtime ---------------------------------------------------------------
APP_ENV=development            # development | staging | production
HTTP_ADDR=:8080
HTTP_PORT=8080                 # used by docker-compose port mapping
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

# --- logging ---------------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=json                # json | text

# --- rate limiting (per client IP) -----------------------------------------
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- redis -----------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- database --------------------------------------------------------------
DATABASE_DSN=app:app@tcp(mysql:3306)/app?parseTime=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE=5m
DB_CONN_MAX_LIFE=30m

# --- security --------------------------------------------------------------
# Required in production; generate with: openssl rand -hex 32
SESSION_AUTH_KEY=
SESSION_ENC_KEY=
API_TOKEN=dev-token            # required by RequireAuth middleware
